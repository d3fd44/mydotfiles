#! /usr/bin/env bash

set -euo pipefail

REPO_DIR="$(pwd)"
shopt -s nullglob dotglob

IGNORES=()
if [ -r "$REPO_DIR/.ignore" ]; then
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        [ -z "$line" ] && continue

        IGNORES+=("$line")
    done < "$REPO_DIR/.ignore"
fi

should_ignore() {
    local name="$1"
    for pat in "${IGNORES[@]}"; do
        case "$name" in
            $pat) return 0 ;;
        esac
    done
    return 1
}

overwrite() {
    local target="$1"
    printf "'%s' exists. overwrite? (y/N) " "$target"
    read -r ans
    case "$ans" in
        y|Y) return 0 ;;
        *) return 1 ;;
    esac
}

link_item() {
    local src="$1" dst="$2"
    if [ -e "$dst" ] || [ -L "$dst" ]; then
        if [ -L "$dst" ] && [ "$(readlink -f "$dst")" == "$(readlink -f "$src")" ]; then
            printf "skipping (already linked): %s -> %s\n" "$dst" "$src"
            return
        fi
        if overwrite "$dst"; then
            rm -rf "$dst"
        else
            printf "skipped: %s\n" "$dst"
            return
        fi
    fi
    ln -s "$src" "$dst"
    printf "linked: %s -> %s\n" "$dst" "$src"
}


for f in "$REPO_DIR"/*; do
    [ -e "$f" ] || continue

    name=${f#$REPO_DIR/}
    should_ignore "$name" && continue

    [ -f "$f" ] && link_item "$f" "$HOME/$name"
    [ -d "$f" ] && link_item "$f" "$HOME/.config/$name"
done
