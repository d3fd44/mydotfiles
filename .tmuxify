#! /usr/bin/env bash

TMUXIFY_DEFAULT_SHELL="${TMUXIFY_DEFAULT_SHELL:-${SHELL:-bash}}"

getabspath() {
    dir="$1"
    [ -z "$dir" ] && dir="."
    case "$dir" in
    ~) dir="$HOME" ;;
    ~/*) dir="${HOME}${dir#~}" ;;
    esac

    if command -v realpath >/dev/null 2>&1; then
        realpath "$dir"
    elif command -v readlink >/dev/null 2>&1; then
        readlink -f "$dir" 2>/dev/null || (cd "$dir" 2>/dev/null && pwd -P)
    else
        (cd "$dir" 2>/dev/null && pwd -P) || {
            echo "path not found" >&2
            return 1
        }
    fi
}

launch() {
    PROJECT_DIR=$(getabspath "$1") || {
        echo "failed to get path of $1" >&2
        return 1
    }
    file="$PROJECT_DIR/tmuxify.json"

    [[ -f "$file" ]] || {
        echo "no config: $file" >&2
        return 1
    }
    jq -e . "$file" >/dev/null 2>&1 || {
        echo "invalid json: $file" >&2
        return 1
    }

    split_flag() {
        case "$1" in
        h | horizontal) printf -- "-h" ;;
        v | vertical) printf -- "-v" ;;
        *) printf -- "-h" ;;
        esac
    }

    resolve_workdir() {
        local wd="$1"
        if [ -z "$wd" ]; then
            printf '%s' "$PROJECT_DIR"
            return
        fi
        if [[ "$wd" = /* ]]; then
            printf '%s' "$wd"
        else
            printf '%s' "$PROJECT_DIR/$wd"
        fi
    }

    shell_quote() {
        printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
    }

    resolve_shell() {
        local shell_value="$1"
        if [ -n "$shell_value" ]; then
            printf '%s' "$shell_value"
        else
            printf '%s' "$TMUXIFY_DEFAULT_SHELL"
        fi
    }

    send_pane_startup() {
        local target="$1"
        local workdir="$2"
        local command="$3"
        local startup_cmd="cd -- $(shell_quote "$workdir")"

        if [ -n "$command" ]; then
            startup_cmd="${startup_cmd} && ${command}"
        fi

        tmux send-keys -t "$target" "$startup_cmd" C-m
    }

    jq -c '.sessions[]' "$file" | while read -r session_json; do
        session_name=$(jq -r '.name // empty' <<<"$session_json")
        [ -z "$session_name" ] && session_name="session_$(date +%s%N)"

        if ! tmux has-session -t "$session_name" 2>/dev/null; then
            tmux new-session -d -s "$session_name" -n "tmuxify" >/dev/null
        fi

        jq -c '.windows[]' <<<"$session_json" | nl -ba -v1 | while read -r idx win_line; do
            win_json=$(cut -f2- <<<"$win_line")
            win_name=$(jq -r '.name // empty' <<<"$win_json")
            win_name=${win_name:-window_$idx}

            win_workdir_raw=$(jq -r '.workdir // empty' <<<"$win_json")
            win_workdir=$(resolve_workdir "$win_workdir_raw")

            panes_count=$(jq '.panes | length // 0' <<<"$win_json")
            win_command=$(jq -r '.command // empty' <<<"$win_json")
            win_shell_raw=$(jq -r '.shell // empty' <<<"$win_json")
            win_shell=$(resolve_shell "$win_shell_raw")

            if [ "$panes_count" -eq 0 ] && [ -n "$win_command" ]; then
                target=$(tmux new-window -d -P -F '#{pane_id}' -t "${session_name}" -n "$win_name" "$win_shell")
                send_pane_startup "$target" "$win_workdir" "$win_command"
                continue
            fi

            target=$(tmux new-window -d -P -F '#{pane_id}' -t "${session_name}" -n "$win_name" "$win_shell")

            first=1
            if [[ $panes_count -ne 0 ]]; then
                jq -c '.panes[]' <<<"$win_json" | nl -ba -v1 | while read -r pidx pane_line; do
                    pane_json=$(cut -f2- <<<"$pane_line")
                    pane_name=$(jq -r '.name // empty' <<<"$pane_json")
                    pane_name=${pane_name:-pane_$pidx}
                    split=$(jq -r '.split // empty' <<<"$pane_json")
                    command=$(jq -r '.command // empty' <<<"$pane_json")
                    pane_workdir_raw=$(jq -r '.workdir // empty' <<<"$pane_json")
                    pane_shell_raw=$(jq -r '.shell // empty' <<<"$pane_json")
                    pane_shell=$(resolve_shell "${pane_shell_raw:-$win_shell}")
                    source_files_count=$(jq '.["source-file"] | length // 0' <<<"$pane_json")
                    workdir="$win_workdir"
                    if [ -n "$pane_workdir_raw" ]; then
                        workdir=$(resolve_workdir "$pane_workdir_raw")
                    elif [ "$source_files_count" -gt 0 ]; then
                        first_source=$(jq -r '.["source-file"][0]' <<<"$pane_json")
                        if [[ "$first_source" = /* ]]; then
                            workdir=$(dirname "$first_source")
                        else
                            workdir="$PROJECT_DIR/$(dirname "$first_source")"
                        fi
                    fi

                    if [ "$first" -eq 1 ]; then
                        send_pane_startup "$target" "$workdir" "$command"
                        first=0
                    else
                        flag=$(split_flag "$split")
                        target=$(tmux split-window $flag -d -P -F '#{pane_id}' -t "${session_name}:${win_name}" "$pane_shell")
                        send_pane_startup "$target" "$workdir" "$command"
                    fi
                done
            fi

            tmux select-layout -t "${session_name}:${win_name}" tiled >/dev/null 2>&1 || true
        done

        if tmux list-windows -t "$session_name" -F '#W' 2>/dev/null | grep -qx 'tmuxify'; then
            count=$(tmux list-windows -t "$session_name" 2>/dev/null | wc -l)
            if [ "$count" -gt 1 ]; then
                tmux kill-window -t "${session_name}:tmuxify" >/dev/null 2>&1 || true
            else
                first_window_name=$(tmux list-windows -t "$session_name" -F '#W' | head -n1)
                tmux rename-window -t "${session_name}" "$first_window_name" >/dev/null 2>&1 || true
            fi
        fi
    done
}
